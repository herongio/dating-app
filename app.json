{
  "expo": {
    "name": "dating-app",
    "slug": "dating-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "내 주변 이상형을 찾기 위해 위치 정보를 사용합니다."
      }
    },
    "android": {},
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "내 주변 이상형을 찾기 위해 위치 정보를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 등록하기 위해 사진 보관함에 접근합니다."
        }
      ],
      "expo-notifications"
    ]
  }
}
